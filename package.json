{
  "name": "game-lab-3d",
  "version": "1.0.0",
  "private": true,
  "description": "3D browser game starter kit (Three.js + Vite) for student teams to build their own games",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:single": "node scripts/build-single.mjs",
    "preview:artifact": "node scripts/preview-artifact.mjs",
    "submit": "node scripts/submit.mjs",
    "build-id": "node scripts/build-id.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
